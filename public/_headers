/auth
  Cache-Control: no-store, max-age=0

/auth/*
  Cache-Control: no-store, max-age=0

/auth/index.html
  Cache-Control: no-store, max-age=0

/auth.html
  Cache-Control: no-store, max-age=0

/index.html
  Cache-Control: no-cache, max-age=0

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
