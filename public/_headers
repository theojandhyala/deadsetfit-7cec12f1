/auth
  Cache-Control: no-store, max-age=0

/auth/*
  Cache-Control: no-store, max-age=0

/auth/index.html
  Cache-Control: no-store, max-age=0

/auth.html
  Cache-Control: no-store, max-age=0

/index.html
  Cache-Control: no-cache, max-age=0

# Browsers may cache hashed assets forever (the boot watchdog in index.html
# heals any client that caches a bad response). The EDGE must not: a request
# racing a deploy can get the SPA-fallback HTML served under an asset URL,
# and with a year-long edge TTL that poisons the CDN for every visitor
# (observed live 2026-07-14). A short CDN TTL makes that self-heal in <=1 min.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: max-age=60

/*.js
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: max-age=60

/*.css
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: max-age=60

/*
  X-Content-Type-Options: nosniff
