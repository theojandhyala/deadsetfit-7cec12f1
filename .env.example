# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public App Store product URL used by /tiktok campaign creative. Replace with
# the final App Store Connect URL before launching a TikTok app-install ad.
VITE_APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID

# RevenueCat public iOS SDK key (safe to include in the client binary)
VITE_REVENUECAT_IOS_API_KEY=appl_mdjAKLIMJMfPvLfxNpUaQmBPWkJ

# Google + Apple sign-in — worker-only secrets, set with `wrangler secret put`.
# Never needed at build time; see docs/oauth-setup.md.
#   GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET
#   APPLE_OAUTH_CLIENT_ID        (Apple Services ID, e.g. org.deadsetfit.web)
#   SUPABASE_SERVICE_ROLE_KEY    (only for a Supabase project you administer)
#   OAUTH_STATE_SECRET           (optional; falls back to the service-role key)
#   TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET
#   TIKTOK_STATE_SECRET          (a separate random secret for encrypted TikTok tokens)
#   LOVABLE_OAUTH_PROJECT_ID     (optional managed-broker project override)

# Map tiles — MapLibre GL uses OpenFreeMap (free, no token needed)
# If you want Mapbox tiles instead, add your token here and update RunMap.tsx
# VITE_MAPBOX_TOKEN=pk.your_token_here
