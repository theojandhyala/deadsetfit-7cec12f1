# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI provider — use gemini to avoid Anthropic costs, anthropic for Claude, or omit for automatic fallback.
AI_PROVIDER=gemini

# AI keys — powers meal scan, meal plan, AI coach, physique scanner, and AI library tools.
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=sk-ant-...

# Map tiles — MapLibre GL uses OpenFreeMap (free, no token needed)
# If you want Mapbox tiles instead, add your token here and update RunMap.tsx
# VITE_MAPBOX_TOKEN=pk.your_token_here
