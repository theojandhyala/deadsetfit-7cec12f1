# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google + Apple sign-in — worker-only secrets, set with `wrangler secret put`.
# Never needed at build time; see docs/oauth-setup.md.
#   GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET
#   APPLE_OAUTH_CLIENT_ID        (Apple Services ID, e.g. org.deadsetfit.web)
#   OAUTH_STATE_SECRET           (optional; falls back to the service-role key)

# Map tiles — MapLibre GL uses OpenFreeMap (free, no token needed)
# If you want Mapbox tiles instead, add your token here and update RunMap.tsx
# VITE_MAPBOX_TOKEN=pk.your_token_here
